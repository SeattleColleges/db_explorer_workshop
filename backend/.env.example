# APP
NODE_ENV=development
PORT=3001

# Database — Supabase Transaction Pooler (IPv4-compatible)
# How to get your connection string:
#   1. Go to your Supabase project page
#   2. Click "Connect" in the top bar
#   3. Select "Direct" tab → choose "Transaction pooler"
#   4. Copy the URI — it looks like:
#      postgresql://postgres.[project-ref]:[password]@aws-1-us-east-1.pooler.supabase.com:6543/postgres
#
# Special characters in the password must be percent-encoded:
#   #  →  %23       @  →  %40       $  →  %24       !  →  %21
#
# Paste your connection string in your .env file — NOT in this .env.example
DATABASE_URL=[your transaction pooler connection string]

# The Supabase table to query — set this to the name of your table
TABLE_NAME=your_table_name

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
